# === Telegram ===
# Get this from @BotFather (see README.md). Looks like: 123456789:AA...
# IMPORTANT: also disable Privacy Mode in BotFather so the bot can see group messages.
TELEGRAM_BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE

# === Google Gemini (optional but recommended) ===
# Get a free key at https://aistudio.google.com/apikey
# Standard keys start with "AIza...". If yours starts with "AQ.Ab8..." it's an
# OAuth token and won't work here.
# The bot works WITHOUT this too — it just falls back to pre-written funny text.
GEMINI_API_KEY=PUT_YOUR_GEMINI_API_KEY_HERE

# === Storage ===
# Where the SQLite file lives. On free hosts point this at a persistent volume
# (e.g. /data/ldr.db on Fly.io) so streaks survive restarts.
DB_PATH=ldr.db
